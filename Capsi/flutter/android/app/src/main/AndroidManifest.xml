<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capsi talks to peers on the local network in every build, so the
         permission belongs in the main manifest, not only in debug. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Capsi's peer discovery is a UDP broadcast, and Android's Wi-Fi stack
         drops broadcast and multicast datagrams that are not addressed to this
         device unless a MulticastLock is held. Without this permission the
         phone neither hears a peer's announcement nor is heard in return, while
         everything else about the app looks healthy. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- The Rust message listener runs in the app process, so a backgrounded
         Capsi can be reclaimed by the platform and stop receiving. This service
         holds the process in the foreground for as long as the app is open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14 (API 34) requires a type, and a persistent network listener is
         exactly the dataSync case. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Android 13+ requires an explicit runtime grant before an app may post
         any notification. Without it the service notification and the incoming
         message notifications are both silently dropped. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Capsi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Keeps the message listener alive while Capsi is in the background. -->
        <service
            android:name=".MessageListenerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The About surface opens https://capsi.win in the browser. Android 11+
             hides installed packages that match an intent unless the intent is
             declared here, and a browser cannot be resolved without this. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
